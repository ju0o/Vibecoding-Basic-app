rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null
    }

    function isOwner(uid) {
      return request.auth.uid == uid
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
    }

    function isModerator() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator')
    }

    function isMember() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['member', 'trusted_member', 'moderator', 'admin'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
    }

    match /categories/{categoryId} {
      allow read: if resource.data.status == 'active';
      allow write: if isAdmin();
    }

    match /categoryRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.requestedByUid == request.auth.uid || isModerator());
      allow create: if isMember() && request.resource.data.requestedByUid == request.auth.uid && request.resource.data.status == 'submitted';
      allow update, delete: if false;
    }

    // Users collection
    match /users/{uid} {
      // Anyone can read their own profile
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());

      // Users can create their own profile
      allow create: if isAuthenticated() && isOwner(uid) &&
        request.resource.data.role == 'pending_member' &&
        request.resource.data.status == 'active';

      // Users can update their own profile (limited fields)
      allow update: if isAuthenticated() && isOwner(uid) &&
        // Cannot change own role or status
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.applicationStatus == resource.data.applicationStatus;

      // Admins can update any user
      allow update: if isAdmin();

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read published posts
      allow read: if true;

      // Members can create posts
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0;

      // Authors can update their own posts, admins/moderators can update any
      allow update: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator()) &&
        (!('likeCount' in resource.data) || request.resource.data.likeCount == resource.data.likeCount) &&
        (!('commentCount' in resource.data) || request.resource.data.commentCount == resource.data.commentCount);

      // Authors can delete their own posts, admins/moderators can delete any
      allow delete: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());
    }

    // Comments collection
    match /posts/{postId}/comments/{commentId} {
      // Anyone can read comments
      allow read: if true;

      // Members can create comments
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid;

      // Authors can update their own comments, admins/moderators can update any
      allow update: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());

      // Authors can delete their own comments, admins/moderators can delete any
      allow delete: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());
    }

    // Likes collection
    match /likes/{likeId} {
      // Anyone can read likes
      allow read: if true;

      // Users can create their own likes
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can delete their own likes, admins can delete any
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // GOOSE-05 canonical top-level comments. Counters and notifications are server-owned.
    match /comments/{commentId} {
      allow read: if resource.data.status == 'published' ||
        (isMember() && (resource.data.authorUid == request.auth.uid || isModerator()));
      allow create: if isMember() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status == 'published' &&
        request.resource.data.targetType in ['post', 'material'] &&
        request.resource.data.bodyMarkdown is string &&
        request.resource.data.bodyMarkdown.size() > 0 &&
        request.resource.data.bodyMarkdown.size() <= 5000;
      allow update: if false;
      allow delete: if isAuthenticated() &&
        (resource.data.authorUid == request.auth.uid || isModerator());
    }

    // GOOSE-05 deterministic reaction ID: {targetType}__{targetId}__{uid}.
    match /reactions/{reactionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isMember() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.targetType in ['post', 'material'] &&
        request.resource.data.type == 'like' &&
        reactionId == request.resource.data.targetType + '__' + request.resource.data.targetId + '__' + request.resource.data.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Materials collection
    match /materials/{materialId} {
      allow read: if resource.data.status in ['official', 'community', 'archived'] ||
        (isAuthenticated() && (resource.data.authorUid == request.auth.uid || isModerator()));
      allow create: if isMember() &&
        request.resource.data.authorUid == request.auth.uid &&
        (request.resource.data.status == 'draft' ||
         (request.resource.data.status == 'community' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trusted_member')) &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.sourceType in ['original', 'external'] &&
        ((!('resourceUrl' in request.resource.data) && request.resource.data.sourceType == 'original') ||
         (request.resource.data.sourceType == 'external' && request.resource.data.resourceUrl is string && request.resource.data.resourceUrl.size() >= 1 && request.resource.data.resourceUrl.size() <= 2048));
      allow update: if isMember() &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.likeCount == resource.data.likeCount &&
        request.resource.data.commentCount == resource.data.commentCount &&
        (request.resource.data.status == resource.data.status ||
         (resource.data.status == 'draft' && request.resource.data.status == 'pending_review') ||
         (resource.data.status == 'needs_revision' && request.resource.data.status == 'pending_review'));
      allow delete: if false;
    }

    // Bookmarks collection — D-007 deterministic ID {uid}__{targetType}__{targetId}, owner-only, no counter
    match /bookmarks/{bookmarkId} {
      allow create: if isMember() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.targetType in ['post', 'material'] &&
        bookmarkId == request.resource.data.uid + '__' + request.resource.data.targetType + '__' + request.resource.data.targetId;
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
