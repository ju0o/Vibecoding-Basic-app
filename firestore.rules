rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null
    }

    function isOwner(uid) {
      return request.auth.uid == uid
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
    }

    function isModerator() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator')
    }

    function isMember() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['member', 'trusted_member', 'moderator', 'admin'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
    }

    // Users collection
    match /users/{uid} {
      // Anyone can read their own profile
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());

      // Users can create their own profile
      allow create: if isAuthenticated() && isOwner(uid) &&
        request.resource.data.role == 'pending_member' &&
        request.resource.data.status == 'active';

      // Users can update their own profile (limited fields)
      allow update: if isAuthenticated() && isOwner(uid) &&
        // Cannot change own role or status
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.applicationStatus == resource.data.applicationStatus;

      // Admins can update any user
      allow update: if isAdmin();

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read published posts
      allow read: if true;

      // Members can create posts
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid;

      // Authors can update their own posts, admins/moderators can update any
      allow update: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());

      // Authors can delete their own posts, admins/moderators can delete any
      allow delete: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());
    }

    // Comments collection
    match /posts/{postId}/comments/{commentId} {
      // Anyone can read comments
      allow read: if true;

      // Members can create comments
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid;

      // Authors can update their own comments, admins/moderators can update any
      allow update: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());

      // Authors can delete their own comments, admins/moderators can delete any
      allow delete: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());
    }

    // Likes collection
    match /likes/{likeId} {
      // Anyone can read likes
      allow read: if true;

      // Users can create their own likes
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can delete their own likes, admins can delete any
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Materials collection
    match /materials/{materialId} {
      // Anyone can read official/community materials
      allow read: if resource.data.status in ['official', 'community'] ||
        (isAuthenticated() && (isOwner(resource.data.authorId) || isModerator()));

      // Members can create materials
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'draft';

      // Authors can update their own materials, admins/moderators can update any
      allow update: if isMember() &&
        (resource.data.authorId == request.auth.uid || isModerator());

      // Admins/moderators can delete materials
      allow delete: if isModerator();
    }
  }
}
